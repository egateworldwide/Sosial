# Copy to `.env` and fill in. Never commit `.env`.
# NOTE: these secrets are also needed as EAS secrets for production builds:
#   eas secret:create --name EXPO_PUBLIC_META_APP_ID --value ...
EXPO_PUBLIC_META_APP_ID=PASTE_META_APP_ID
EXPO_PUBLIC_META_APP_SECRET=PASTE_META_APP_SECRET
EXPO_PUBLIC_THREADS_APP_ID=PASTE_THREADS_APP_ID
EXPO_PUBLIC_THREADS_APP_SECRET=PASTE_THREADS_APP_SECRET
EXPO_PUBLIC_IG_APP_ID=PASTE_IG_APP_ID
EXPO_PUBLIC_IG_APP_SECRET=PASTE_IG_APP_SECRET
EXPO_PUBLIC_TT_CLIENT_KEY=PASTE_TIKTOK_CLIENT_KEY
EXPO_PUBLIC_TT_CLIENT_SECRET=PASTE_TIKTOK_CLIENT_SECRET
EXPO_PUBLIC_X_CLIENT_ID=PASTE_X_CLIENT_ID
EXPO_PUBLIC_LI_CLIENT_ID=PASTE_LINKEDIN_CLIENT_ID
EXPO_PUBLIC_LI_CLIENT_SECRET=PASTE_LINKEDIN_CLIENT_SECRET
EXPO_PUBLIC_YT_CLIENT_ID=PASTE_YOUTUBE_CLIENT_ID
EXPO_PUBLIC_YT_CLIENT_SECRET=PASTE_YOUTUBE_CLIENT_SECRET
EXPO_PUBLIC_PIN_CLIENT_ID=PASTE_PINTEREST_APP_ID
EXPO_PUBLIC_PIN_CLIENT_SECRET=PASTE_PINTEREST_APP_SECRET
# Supabase staging (public anon key only — service_role NEVER goes here).
# Google sign-in needs no app-side keys: the Google Cloud client lives in the
# Supabase dashboard (Auth → Providers → Google), not in code.
EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=PASTE_SUPABASE_ANON_KEY
