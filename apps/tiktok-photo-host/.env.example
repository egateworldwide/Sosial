# Placeholder — copy to `.env`. Never commit real values.
# Public origin of THIS service (your own verified domain, no trailing slash).
# Standard subdomain used throughout the docs:
BASE_URL=https://photos.sosial.app
# Shared secret. Paste the full URL *with* ?key= into the app
# (Connect → TikTok photo host), e.g. https://photos.sosial.app/upload?key=PASTE_KEY
UPLOAD_KEY=PASTE_LONG_RANDOM_KEY
# Files self-delete this many hours after upload (TikTok pulls within minutes).
TTL_HOURS=24
# Disk location. On Railway attach a volume and set DATA_DIR=/data.
DATA_DIR=./data
# Railway injects PORT automatically; local default is 3000.
PORT=3000
